#cloud-config
# Receptor coldcopy: sin EIP ni Internet. Habla con OBS por la red interna
# usando las credenciales temporales de su agencia. El agente usa solo la
# biblioteca estándar de Python; qemu-img es opcional (si el repositorio
# interno no responde, el agente usa su propio conversor de VMDK).
write_files:
  - path: /etc/coldcopy.env
    permissions: "0644"
    content: |
      BUCKET=${bucket}
      REGION=${region}
  - path: /usr/local/bin/coldcopy-receptor.py
    permissions: "0755"
    content: |
      ${indent(6, agente)}
  - path: /etc/systemd/system/coldcopy-receptor.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Agente receptor coldcopy (OBS -> EVS)
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/python3 /usr/local/bin/coldcopy-receptor.py
  - path: /etc/systemd/system/coldcopy-receptor.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Ejecuta el agente receptor coldcopy cada minuto

      [Timer]
      OnBootSec=30s
      OnUnitActiveSec=60s

      [Install]
      WantedBy=timers.target
runcmd:
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, coldcopy-receptor.timer]
  - [bash, -c, "timeout 600 dnf -y install qemu-img > /var/log/coldcopy-qemu-img.log 2>&1 || echo 'qemu-img no disponible: se usa el conversor propio' >> /var/log/coldcopy-qemu-img.log"]
